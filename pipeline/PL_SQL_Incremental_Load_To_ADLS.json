{
	"name": "PL_SQL_Incremental_Load_To_ADLS",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Old_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "\nSELECT last_watermark_value\nFROM dbo.pipeline_watermark\nWHERE source_table_name = 'retail_customers_source'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "dbo",
							"tableName": "pipeline_watermark"
						}
					}
				}
			}
		],
		"parameters": {
			"sourceSchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"sourceTableName": {
				"type": "string",
				"defaultValue": "retail_customers_source"
			},
			"watermarkColumn": {
				"type": "string",
				"defaultValue": "updated_at"
			},
			"targetContainer": {
				"type": "string",
				"defaultValue": "raw"
			},
			"targetFolderPath": {
				"type": "string",
				"defaultValue": "retail/customers/incremental/"
			},
			"targetFileName": {
				"type": "string",
				"defaultValue": "customers_incremental.parquet"
			}
		},
		"annotations": []
	}
}